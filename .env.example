# ---------------------------------------------------------------------------
# Client IP behind Render (measured 2026-09-21). Cloudflare sets
# True-Client-IP and overwrites any client-sent value; X-Forwarded-For is
# "client, cloudflare-edge, render-internal". Leave these unless the edge changes.
# ---------------------------------------------------------------------------
CLIENT_IP_HEADER=HTTP_TRUE_CLIENT_IP
TRUSTED_PROXY_COUNT=3
# Staging-only /health/request-ip/ diagnostic (defaults on only when PUSH_ENVIRONMENT=staging)
# IP_DIAGNOSTICS_ENABLED=false

# ---------------------------------------------------------------------------
# Rate limits (all optional; invalid values fall back to the default and log a
# warning). Format: N/<window>, e.g. 60/5m, 300/h, 1000/d, 10/minute.
# IP limits are generous because campus Wi-Fi and carrier NAT share one IP;
# tight limits key on the email, refresh token or signed-in user.
# Without Redis, counters are per worker process (limits ~ workers x rate).
# ---------------------------------------------------------------------------
# THROTTLE_BURST_USER=120/m
# THROTTLE_SUSTAINED_USER=5000/d
# THROTTLE_BURST_ANON=300/m
# THROTTLE_SUSTAINED_ANON=20000/d
# SIGNUP_IP_BURST_RATE=60/5m
# SIGNUP_IP_HOURLY_RATE=300/h
# SIGNUP_IP_DAILY_RATE=1000/d
# SIGNUP_ACCOUNT_RATE=10/h
# LOGIN_IP_BURST_RATE=60/m
# LOGIN_IP_HOURLY_RATE=600/h
# LOGIN_ACCOUNT_BURST_RATE=10/5m
# LOGIN_ACCOUNT_HOURLY_RATE=30/h
# SOCIAL_LOGIN_IP_BURST_RATE=60/m
# SOCIAL_LOGIN_IP_HOURLY_RATE=1000/h
# REFRESH_TOKEN_RATE=10/m
# REFRESH_IP_RATE=600/m
# PASSWORD_RESET_RATE=3/h
# PASSWORD_RESET_DAILY_RATE=6/d
# PASSWORD_RESET_IP_RATE=30/h
# RESET_PASSWORD_IP_RATE=60/h
# RESET_PASSWORD_TOKEN_RATE=10/h
# PAYMENT_INIT_RATE=20/h
# COUPON_VALIDATE_RATE=10/10m
# COUPON_VALIDATE_DAILY_RATE=50/d
# REFERRAL_APPLY_RATE=5/h
# UPLOAD_RATE=20/h
# THROTTLE_REVIEW=5/h
# THROTTLE_FEEDBACK=3/h

# Launch default: no critical notification/email depends on a running worker.
PUSH_USE_CELERY=false
CRITICAL_TASKS_USE_CELERY=false
EMAIL_TIMEOUT=10
# Needs an email-verification step first; only Google/Apple users are verified today.
PROMO_REQUIRE_VERIFIED_EMAIL=false
# Only opt into Celery dispatch when workers AND outbox recovery are monitored.

# Email over HTTPS (Render blocks outbound SMTP). Set one; SMTP is the fallback.
BREVO_API_KEY=
RESEND_API_KEY=
